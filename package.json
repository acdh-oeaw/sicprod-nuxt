{
	"name": "@acdh-oeaw/sicprod-frontend",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "26.x",
		"pnpm": "12.x"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		}
	},
	"scripts": {
		"analyze": "dotenv -c -- nuxt analyze",
		"build": "nuxt build --dotenv ./.env.local",
		"dev": "nuxt dev --dotenv ./.env.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate": "nuxt generate --dotenv ./.env.local",
		"generate:api-client": "dotenv -c -- tsx ./scripts/generate-api-client.ts",
		"generate:iiif-manifest": "dotenv -c -- tsx ./scripts/generate-iiif-manifest.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:styles:check": "stylelint \"**/*.{css,vue}\" --cache --ignore-path .gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"postinstall": "nuxt prepare",
		"prepare": "run-s generate:api-client generate:iiif-manifest",
		"start": "nuxt preview --dotenv ./.env.local",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.1.12",
		"@floating-ui/vue": "^1.1.11",
		"@fontsource-variable/inter": "^5.3.0",
		"@headlessui/tailwindcss": "^0.2.2",
		"@headlessui/vue": "^1.7.23",
		"@iiif/builder": "^2.0.1",
		"@iiif/presentation-3": "^2.2.4",
		"@jsplumb/browser-ui": "^6.2.10",
		"@nuxt/content": "^2.13.4",
		"@nuxt/image": "^1.11.2",
		"@nuxtjs/color-mode": "^3.5.2",
		"@nuxtjs/i18n": "^8.5.6",
		"@nuxtjs/leaflet": "^1.3.3",
		"@tanstack/vue-query": "^5.108.4",
		"@vueuse/core": "^11.3.0",
		"@vueuse/nuxt": "^11.3.0",
		"@zodios/core": "^10.9.6",
		"citation-js": "^0.7.22",
		"d3": "^7.9.2",
		"d3-force": "^3.0.1",
		"d3-time-format": "^4.1.1",
		"fast-glob": "^3.3.3",
		"force-graph": "^1.52.0",
		"lucide-vue-next": "^0.453.0",
		"nuxt": "^3.21.11",
		"openapi-zod-client": "^1.18.3",
		"pino-http": "^10.5.0",
		"satori": "^0.11.3",
		"tify": "^0.31.0",
		"vue": "^3.5.46",
		"vue-i18n": "^9.14.5",
		"vue-i18n-routing": "^1.2.0",
		"vue-router": "^4.6.5",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tailwindcss-preset": "^0.0.22",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@nuxt/devtools": "^1.7.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/d3": "^7.4.3",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^22.20.7",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.5.0",
		"dotenv": "^16.6.1",
		"dotenv-cli": "^7.4.4",
		"dotenv-expand": "^11.0.7",
		"globals": "^15.15.0",
		"lefthook": "^2.2.4",
		"npm-run-all2": "^7.0.2",
		"openapi3-ts": "^4.6.2",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"postcss": "^8.5.33",
		"schema-dts": "^1.1.5",
		"stylelint": "^18.1.0",
		"tailwind-scrollbar": "^3.1.0",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vue-tsc": "^2.2.12"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"postcss": {
		"plugins": {
			"tailwindcss": {}
		}
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}
